{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn lint*)",
      "Bash(yarn type-check*)",
      "Bash(yarn build*)",
      "Bash(yarn db:generate*)",
      "Bash(yarn db:migrate:status*)",
      "Bash(npx tsc *)",
      "Bash(npx prisma generate *)",
      "Bash(npx prisma validate *)",
      "Bash(npx prisma format *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/**/.env)",
      "Read(./apps/**/.env.*)",
      "Read(./apps/mobile-android/keystore.properties)",
      "Read(./apps/mobile-android/keystore/**)",
      "Read(./apps/mobile/fastlane/*.p8)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/production-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
