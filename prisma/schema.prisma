model Post {
  id      Int     @id @default(autoincrement())
  title   String
  slug    String
  locale  String  @default("vi") // Language code: en, vi, zh, ko, ja
  translationKey String? // Stable translated-edition group; legacy rows remain null.
  content String // Rich text content stored as JSON string (TipTap format)
  excerpt String? // Short description for previews

  // SEO Fields
  seoTitle       String?
  seoDescription String?
  seoKeywords    String? // Comma-separated

  // Status & Publishing
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Author
  authorId Int
  author   User @relation("PostAuthor", fields: [authorId], references: [id])

  // Relationships
  categories PostCategoryRelation[]
  tags       PostTagRelation[]

  // Featured image
  featuredImage String?

  @@unique([slug, locale]) // Slug must be unique per locale
  @@unique([translationKey, locale])
  @@index([status, publishedAt])
  @@index([slug])
  @@index([locale])
  @@index([authorId])
  @@index([createdAt])
  @@index([locale, status]) // For filtering posts by locale and status
}

model PostCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts PostCategoryRelation[]

  @@index([slug])
  @@index([isActive])
}

model PostTag {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  posts PostTagRelation[]

  @@index([slug])
}

model PostCategoryRelation {
  postId     Int
  categoryId Int
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   PostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model PostTagRelation {
  postId Int
  tagId  Int
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    PostTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ============================================================================
// LOYALTY PROGRAM
// ============================================================================

/// Loyalty program configuration — ONE per merchant
model LoyaltyProgram {
  id         Int     @id @default(autoincrement())
  merchantId Int     @unique
  name       String  @default("Chương trình khách hàng thân thiết")
  isActive   Boolean @default(false)

  rentEarnEnabled   Boolean @default(true)
  rentEarnRate      Int     @default(1)
  rentEarnPerAmount Float   @default(10000)

  saleEarnEnabled   Boolean @default(true)
  saleEarnRate      Int     @default(1)
  saleEarnPerAmount Float   @default(10000)

  pointValue       Float   @default(1000)
  minRedeemPoints  Int     @default(10)
  maxRedeemPercent Float   @default(50)
  redeemOnRent     Boolean @default(true)
  redeemOnSale     Boolean @default(true)

  tierMetric    String @default("total_spend")
  tierPeriod    String @default("lifetime")
  tierDowngrade String @default("never")

  pointsExpiryMode String @default("never")
  pointsExpiryDays Int?
  yearlyResetMonth Int?
  yearlyResetDay   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tiers    LoyaltyTier[]
}

/// Membership tier definition
model LoyaltyTier {
  id         Int     @id @default(autoincrement())
  programId  Int
  name       String
  threshold  Float   @default(0)
  multiplier Float   @default(1.0)
  benefits   String  @default("[]")
  color      String?
  icon       String?
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program   LoyaltyProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  customers CustomerLoyalty[]

  @@index([programId, threshold])
  @@index([programId, sortOrder])
}

/// Customer loyalty balance — ONE per customer per merchant
model CustomerLoyalty {
  id            Int   @id @default(autoincrement())
  customerId    Int
  merchantId    Int
  points        Int   @default(0)
  totalEarned   Int   @default(0)
  totalRedeemed Int   @default(0)
  totalSpent    Float @default(0)
  totalOrders   Int   @default(0)
  currentTierId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant    Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  currentTier LoyaltyTier?      @relation(fields: [currentTierId], references: [id], onDelete: SetNull)
  pointLots   LoyaltyPointLot[]

  @@unique([customerId, merchantId])
  @@index([merchantId, points])
  @@index([merchantId, totalSpent])
  @@index([merchantId, currentTierId])
}

/// Immutable ledger of all point transactions
model LoyaltyTransaction {
  id           Int      @id @default(autoincrement())
  customerId   Int
  merchantId   Int
  outletId     Int?
  orderId      Int?
  type         String
  points       Int
  balanceAfter Int
  description  String?
  metadata     String?
  createdAt    DateTime @default(now())
  createdById  Int?

  customer  Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant  Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  pointLots LoyaltyPointLot[]

  @@index([customerId, merchantId, createdAt])
  @@index([orderId, type])
  @@index([merchantId, type, createdAt])
  @@index([outletId, createdAt])
}

/// Point lots for per-transaction expiry and FIFO redemption
model LoyaltyPointLot {
  id                Int       @id @default(autoincrement())
  customerLoyaltyId Int
  earnTransactionId Int
  pointsEarned      Int
  remainingPoints   Int
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customerLoyalty CustomerLoyalty    @relation(fields: [customerLoyaltyId], references: [id], onDelete: Cascade)
  earnTransaction LoyaltyTransaction @relation(fields: [earnTransactionId], references: [id], onDelete: Cascade)

  @@index([customerLoyaltyId, expiresAt])
  @@index([earnTransactionId])
  @@index([expiresAt, remainingPoints])
}

// ============================================================================
// #907 Feature modules (per merchant) and the attendance module (Chấm công)
// Day keys are Vietnam civil days `YYYY-MM-DD` stored as text (never @db.Date).
// ============================================================================

/// One paid feature module of a merchant. Active = enabled and (endsAt null or endsAt > now).
model MerchantModule {
  id          Int       @id @default(autoincrement())
  merchantId  Int
  /// Catalog key from @rentalshop/constants MODULES, e.g. "attendance"
  key         String
  enabled     Boolean   @default(false)
  /// Inclusive end date stored as the end of that VN day (23:59:59.999 +07)
  endsAt      DateTime?
  updatedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, key])
}

/// Per-outlet attendance location, radius, QR code state and kiosk link.
model AttendanceSetting {
  id           Int       @id @default(autoincrement())
  outletId     Int       @unique
  merchantId   Int
  latitude     Float?
  longitude    Float?
  radiusM      Int       @default(100)
  /// DAILY (changes at 00:00 VN) | FIXED
  qrMode       String    @default("DAILY")
  /// 0 = no QR made yet; every "new code" increments it and kills the older codes
  qrVersion    Int       @default(0)
  qrCreatedAt  DateTime?
  /// 256-bit random token of the counter (kiosk) link; stored so the link can be copied again
  kioskToken   String?   @unique
  kioskTokenAt DateTime?
  /// #959 when the four ready-made shift templates were created (or skipped: the outlet had templates). Set once;
  /// deleting the templates never creates them again.
  templatesSeededAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  outlet       Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

/// Shift template of an outlet ("Ca sáng 08:00–12:00"). endTime <= startTime = crosses midnight.
model ShiftTemplate {
  id           Int      @id @default(autoincrement())
  merchantId   Int
  outletId     Int
  name         String
  /// HH:mm VN wall time
  startTime    String
  endTime      String
  breakMinutes Int      @default(0)
  /// blue | purple | green | orange
  color        String   @default("blue")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  outlet       Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([outletId])
}

/// Weekly repeating assignment of one user to one template ("gán một lần, lặp hằng tuần").
model ShiftRule {
  id          Int      @id @default(autoincrement())
  merchantId  Int
  outletId    Int
  userId      Int
  templateId  Int
  /// 1 = Monday … 7 = Sunday (VN day)
  weekdays    Int[]
  /// VN day keys YYYY-MM-DD, endDate inclusive
  startDate   String
  endDate     String?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([outletId])
  @@index([userId])
  @@index([templateId])
}

/// One-day change of a user's shifts (another template, custom hours, or off).
model ShiftDay {
  id           Int      @id @default(autoincrement())
  merchantId   Int
  outletId     Int
  userId       Int
  dateKey      String
  off          Boolean  @default(false)
  templateId   Int?
  startTime    String?
  endTime      String?
  breakMinutes Int?
  createdById  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([outletId, dateKey])
  @@index([templateId])
}

/// One IN/OUT pair. Shift fields are a snapshot taken at IN, so template edits never change worked days.
model AttendanceRecord {
  id              Int              @id @default(autoincrement())
  merchantId      Int
  outletId        Int
  userId          Int
  /// VN day key of the shift (or of the IN instant when there is no shift)
  dateKey         String
  shiftTemplateId Int?
  shiftName       String?
  shiftStart      String?
  shiftEnd        String?
  shiftBreak      Int?
  checkInAt       DateTime
  checkOutAt      DateTime?
  /// OPEN | DONE | MISSING_OUT
  status          String           @default("OPEN")
  /// When an OPEN record becomes MISSING_OUT (end of its VN day, or cross-midnight shift end + 4 h)
  closeAt         DateTime?
  inLatitude      Float?
  inLongitude     Float?
  inAccuracy      Float?
  inDistanceM     Int?
  outLatitude     Float?
  outLongitude    Float?
  outAccuracy     Float?
  outDistanceM    Int?
  suspectedFake   Boolean          @default(false)
  /// ZERO_ACCURACY | SAME_COORDS | SPEED
  suspectReasons  String[]
  /// PUNCH | MANUAL
  source          String           @default("PUNCH")
  autoClosedAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  edits           AttendanceEdit[]

  @@index([userId, status])
  @@index([outletId, dateKey])
  @@index([userId, dateKey])
  @@index([status, closeAt])
  @@index([shiftTemplateId])
}

/// Every punch that reached the location / QR checks, accepted or rejected (with coordinates).
model AttendanceScan {
  id         Int      @id @default(autoincrement())
  merchantId Int
  outletId   Int?
  userId     Int
  at         DateTime @default(now())
  /// IN | OUT (intended action)
  action     String?
  /// ACCEPTED or the error code
  result     String
  latitude   Float
  longitude  Float
  accuracy   Float
  distanceM  Int?
  recordId   Int?
  /// #949 QR_WRONG_OUTLET: outlet of the scanned code (same merchant); outletId is then the scanner's outlet
  qrOutletId Int?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([outletId, at])
}

/// Manual change of a record (before / after / reason / editor).
model AttendanceEdit {
  id         Int              @id @default(autoincrement())
  recordId   Int
  editedById Int
  before     Json?
  after      Json
  reason     String
  createdAt  DateTime         @default(now())
  record     AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

/// A locked month of an outlet: no more record edits until the owner unlocks it.
model AttendanceMonthLock {
  id         Int      @id @default(autoincrement())
  outletId   Int
  /// YYYY-MM
  month      String
  lockedById Int
  lockedAt   DateTime @default(now())

  @@unique([outletId, month])
}

/// #1124 Đặt đơn online: a customer's request from the public shop page. Not an order: the shop confirms it, which
/// creates a RESERVED order through POST /api/orders (bookingRequestId). PENDING past expiresAt reads as EXPIRED.
model BookingRequest {
  id            Int                  @id @default(autoincrement())
  /// 5 characters A–Z/2–9 without 0, O, 1, I; shown to the customer and in the tracking link
  code          String               @unique
  merchantId    Int
  outletId      Int
  status        BookingRequestStatus @default(PENDING)
  customerName  String
  /// digits only, a leading + kept
  customerPhone String
  note          String?
  /// start of the Vietnam civil day of pickup / return, like a RENT order created from the apps
  pickupPlanAt  DateTime
  returnPlanAt  DateTime
  expiresAt     DateTime
  /// OUT_OF_STOCK | CANNOT_CONTACT | OTHER
  rejectReason  String?
  rejectNote    String?
  orderId       Int?                 @unique
  customerId    Int?
  decidedById   Int?
  decidedAt     DateTime?
  /// anti-spam only, never shown
  clientIp      String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  items         BookingRequestItem[]

  @@index([merchantId, status, createdAt])
  @@index([outletId, status])
  @@index([customerPhone, createdAt])
}

model BookingRequestItem {
  id          Int            @id @default(autoincrement())
  requestId   Int
  productId   Int
  quantity    Int
  /// product name when sent (the product may be renamed or deleted later)
  productName String
  /// rent price shown when sent, for reference only; the order price comes from the cart
  unitPrice   Float?
  request     BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

enum BookingRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED
}
