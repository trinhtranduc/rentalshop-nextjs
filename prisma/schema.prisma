generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                    @id @default(autoincrement())
  email                  String                 @unique
  password               String
  firstName              String
  lastName               String
  phone                  String?
  role                   UserRole               @default(OUTLET_STAFF)
  customRoleId           Int?
  isActive               Boolean                @default(true)
  emailVerified          Boolean                @default(false)
  emailVerifiedAt        DateTime?
  passwordChangedAt      DateTime?
  permissionsChangedAt   DateTime? // Timestamp when permissions were last changed (to invalidate old tokens)
  lastLoginAt            DateTime? // Test field for migration workflow
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  merchantId             Int?
  outletId               Int?
  deletedAt              DateTime?
  /// #927 must clock in (attendance module). null = role default: OUTLET_STAFF, OUTLET_INVENTORY yes; others no
  attendanceRequired     Boolean?
  auditLogs              AuditLog[]
  requestLogs            RequestLog[]           @relation("RequestLogs")
  /// Google account id (sub) when user signed up or linked Google OAuth
  googleSub              String?                @unique
  emailVerifications     EmailVerification[]
  createdOrders          Order[]
  passwordResets         PasswordReset[]
  subscriptionActivities SubscriptionActivity[]
  posts                  Post[]                 @relation("PostAuthor")
  customRole             MerchantRole?          @relation(fields: [customRoleId], references: [id])
  merchant               Merchant?              @relation(fields: [merchantId], references: [id])
  outlet                 Outlet?                @relation(fields: [outletId], references: [id])
  sessions               UserSession[]
  refreshTokens          RefreshToken[]
  deviceTokens           DeviceToken[]
  notifications          Notification[]
  shiftRules             ShiftRule[]
  shiftDays              ShiftDay[]
  attendanceRecords      AttendanceRecord[]
  attendanceScans        AttendanceScan[]

  @@unique([merchantId, email])
  @@unique([merchantId, phone])
  @@index([email])
  @@index([merchantId])
  @@index([outletId])
  @@index([deletedAt])
  @@index([emailVerified])
}

/// FCM / push tokens for mobile devices (POS notifications)
model DeviceToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  deviceId   String
  pushToken  String
  platform   String // ios | android
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([pushToken])
  @@index([userId, isActive])
  @@index([isActive, platform])
}

/// In-app notification inbox (read / unread). Created when order push events fire.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String // ORDER_CREATED | ORDER_STATUS_CHANGED | ...
  title     String
  body      String
  data      Json? // orderId, orderNumber, status, outletId, ...
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([type])
}

model UserSession {
  id                Int       @id @default(autoincrement())
  userId            Int
  sessionId         String    @unique
  ipAddress         String?
  userAgent         String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  // Sliding sessions (mobile): expiresAt moves forward on use, never past absoluteExpiresAt.
  // Null on both means a fixed-expiry session (web, rows before #343).
  absoluteExpiresAt DateTime?
  idleTimeoutDays   Int?
  invalidatedAt     DateTime?
  // #660: "web" | "mobile". A login replaces only active sessions of its own platform (and NULL ones).
  // NULL = unknown client or a row created before #660; such a login replaces every session.
  platform          String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, isActive, platform])
  @@index([sessionId])
  @@index([expiresAt])
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  deviceId   String?
  userAgent  String?
  ipAddress  String?
  isRevoked  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String? // Token rotation: points to the new token hash
  sessionId  String? // UserSession.sessionId this token refreshes; null tokens cannot refresh
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([tokenHash])
  @@index([sessionId])
  @@index([expiresAt])
}

model Merchant {
  id                   Int                  @id @default(autoincrement())
  name                 String
  email                String               @unique
  phone                String?
  /// Stripe customer id for subscription billing
  stripeCustomerId     String?              @unique
  /// Lemon Squeezy customer id (optional, synced via webhooks)
  lemonCustomerId      String?              @unique
  /// Human friendly tenant key (used for subdomain like aodaipham1.anyrent.shop)
  /// Optional now to avoid breaking existing data, but should be filled for new merchants.
  tenantKey            String?              @unique
  address              String?
  city                 String?
  state                String?
  zipCode              String?
  country              String?
  businessType         BusinessType         @default(GENERAL)
  /// Niche rental tags selected at signup (JSON string[] of BusinessTag codes)
  businessTags         Json?
  taxId                String?
  website              String?
  description          String?
  planId               Int?
  totalRevenue         Float                @default(0)
  lastActiveAt         DateTime?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  pricingConfig        String?              @default("{\"businessType\":\"GENERAL\",\"defaultPricingType\":\"FIXED\",\"businessRules\":{\"requireRentalDates\":false,\"showPricingOptions\":false},\"durationLimits\":{\"minDuration\":1,\"maxDuration\":1,\"defaultDuration\":1}}")
  pricingType          PricingType          @default(FIXED)
  currency             String               @default("USD")
  avatar               String?
  /// #518 "Cho tạo đơn khi trùng lịch". true (default) = today's behaviour, no availability check on save.
  /// false = the API rejects RENT orders that would exceed outlet stock on some VN civil day.
  allowOverlappingOrders Boolean            @default(true)
  /// #1124 Đặt đơn online: customers may send booking requests from the public shop page. Off until the shop turns it on.
  onlineBookingEnabled Boolean              @default(false)
  /// #1174 Hiện giá trên trang shop công khai. true (default) = today's catalogue. false = API nulls amounts; UI shows "Liên hệ".
  showPublicPrice      Boolean              @default(true)
  /// #1189 shop settings JSON (nullable). { blockPricing: { oldApps: 'recompute' | 'block' } }
  settings             Json?
  /// #567 Shop time zone (IANA id). Every "day" of this shop (today, calendar, availability, revenue by day)
  /// is a civil day in this zone. Existing shops and register calls without a zone: Asia/Ho_Chi_Minh.
  timezone             String               @default("Asia/Ho_Chi_Minh")
  /// ID of merchant who referred this merchant (for referral tracking)
  referredByMerchantId Int?
  categories           Category[]
  customers            Customer[]
  Plan                 Plan?                @relation(fields: [planId], references: [id])
  roles                MerchantRole[]
  outlets              Outlet[]
  payments             Payment[]
  products             Product[]
  subscription         Subscription?
  users                User[]
  auditLogs            AuditLog[]
  requestLogs          RequestLog[]         @relation("RequestLogs")
  planLimitAddons      PlanLimitAddon[]
  referredBy           Merchant?            @relation("MerchantReferrals", fields: [referredByMerchantId], references: [id])
  referredMerchants    Merchant[]           @relation("MerchantReferrals")
  loyaltyProgram       LoyaltyProgram?
  customerLoyalty      CustomerLoyalty[]
  loyaltyTransactions  LoyaltyTransaction[]
  modules              MerchantModule[]

  @@index([name])
  @@index([email])
  @@index([planId])
  @@index([referredByMerchantId])
}

model Outlet {
  id           Int           @id @default(autoincrement())
  name         String
  address      String?
  description  String?
  /// Printed at the bottom of RENT receipts, e.g. "Vui lòng mang theo CMND khi lấy đồ" (#347)
  printNote    String?
  /// Print the default bank account + VietQR on bills of this outlet (#628). Synced web ↔ mobile.
  printBankQr  Boolean       @default(false)
  /// #1124 this outlet takes online booking requests (only when Merchant.onlineBookingEnabled)
  acceptsOnlineBooking Boolean @default(true)
  isActive     Boolean       @default(true)
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  merchantId   Int
  phone        String?
  city         String?
  country      String?
  state        String?
  zipCode      String?
  avatar       String?
  bankAccounts BankAccount[]
  orders       Order[]
  auditLogs    AuditLog[]
  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products     OutletStock[]
  users        User[]
  attendanceSetting AttendanceSetting?
  shiftTemplates    ShiftTemplate[]

  @@index([merchantId])
  @@index([name])
  @@index([isDefault])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  merchantId  Int
  isDefault   Boolean   @default(false)
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([merchantId, name])
  @@index([merchantId])
}

model Product {
  id                   Int                    @id @default(autoincrement())
  name                 String
  description          String?
  barcode              String? // unique per shop (@@unique below), not system-wide (#629)
  totalStock           Int                    @default(0)
  rentPrice            Float
  salePrice            Float?
  deposit              Float                  @default(0)
  images               Json?
  isActive             Boolean                @default(true)
  embeddingGeneratedAt DateTime? // Track when embedding was generated and stored in Qdrant
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  merchantId           Int
  categoryId           Int
  costPrice            Float?
  pricingType          PricingType?
  durationConfig       String?
  deletedAt            DateTime? // Soft delete (#389); hidden from lists, kept for orders
  orderItems           OrderItem[]
  outletStock          OutletStock[]
  embeddingJobs        EmbeddingJob[]
  pricingOptions       ProductPricingOption[]
  category             Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  merchant             Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, barcode])
  @@index([merchantId])
  @@index([categoryId])
  @@index([barcode])
  @@index([name])
  @@index([pricingType])
  @@index([embeddingGeneratedAt])
}

model ProductPricingOption {
  id         Int          @id @default(autoincrement())
  productId  Int
  type       PricingType // Phase 1: FIXED | DAILY (BLOCK/HOURLY reserved for future)
  price      Float
  unit       PricingUnit? // null in Phase 1; used by BLOCK/HOURLY later
  blockSize  Int? // null in Phase 1; number of units per block for BLOCK
  // #1189 day-block pricing (type BLOCK only; all null on FIXED / DAILY). `price` of a BLOCK option = day-1 price
  blockTiers      Json? // number[]: all-in price of renting startDay + i days (1..31 entries)
  blockStartDay   Int? // null = 1
  blockExtraMode  String? // 'EXTRA_PER_DAY' | 'HOLD_LAST'; null = EXTRA_PER_DAY
  blockExtraPrice Float? // per day past the last tier (EXTRA_PER_DAY)
  isDefault  Boolean      @default(false)
  isActive   Boolean      @default(true)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId, isActive])
}

model EmbeddingJob {
  id          Int       @id @default(autoincrement())
  productId   Int
  status      String    @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  source      String? // product-create | product-update | bulk-sync | manual
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  nextRunAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([productId, status])
  @@index([createdAt])
}

model OutletStock {
  id        Int      @id @default(autoincrement())
  stock     Int      @default(0)
  available Int      @default(0)
  renting   Int      @default(0)
  // #1341 "Hiện ở chi nhánh": does this branch sell the product (list, order picker). Default true: code that creates
  // a row without it keeps today's behaviour; the server writes false for the zero rows it adds on its own.
  isListed  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productId Int
  outletId  Int
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, outletId])
  @@index([outletId, available])
  @@index([outletId, isListed])
  @@index([productId])
}

model Customer {
  id                  Int                  @id @default(autoincrement())
  firstName           String
  lastName            String?
  email               String?
  phone               String?
  address             String?
  city                String?
  state               String?
  zipCode             String?
  country             String?
  dateOfBirth         DateTime?
  idNumber            String?
  idType              String?
  notes               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  merchantId          Int
  merchant            Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders              Order[]
  loyaltyRecords      CustomerLoyalty[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([merchantId, phone])
  @@index([merchantId, firstName, lastName])
  @@index([deletedAt])
}

model Order {
  id                    Int                  @id @default(autoincrement())
  orderNumber           String               @unique
  orderType             OrderType
  status                OrderStatus          @default(RESERVED)
  totalAmount           Float
  pickupTotalAmount     Float?
  depositAmount         Float                @default(0)
  securityDeposit       Float                @default(0)
  damageFee            Float                @default(0)
  lateFee               Float                @default(0)
  discountType          String?
  discountValue         Float                @default(0)
  discountAmount        Float                @default(0)
  pickupPlanAt          DateTime?
  returnPlanAt          DateTime?
  pickedUpAt            DateTime?
  returnedAt            DateTime?
  rentalDuration        Int?
  isReadyToDeliver      Boolean              @default(false)
  collateralType        String?
  collateralDetails     String?
  collateralImageUrl    String?
  notes                 String?
  notesImages           Json?
  pickupNotes           String?
  pickupNotesImages     Json?
  returnNotes           String?
  returnNotesImages     Json?
  damageNotes           String?
  damageNotesImages     Json?
  loyaltyPointsRedeemed Int                  @default(0)
  loyaltyDiscount       Float                @default(0)
  loyaltyPointsEarned   Int                  @default(0)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  outletId              Int
  customerId            Int?
  createdById           Int? // Allow null to support user deletion
  rentalDurationUnit    String?
  /// #1199 staged deposits: { v, policy?, items: [{ key, label, type: 'PERCENT', value, dueRule | dueDateKey, amountOverride? }] }.
  /// null = old order / "Thu cọc 1 lần". The last stage `rest` is never stored. Read it through effectivePlan().
  depositPlan           Json?
  /// #1199 money the shop keeps when a staged order is cancelled (null = not set)
  cancelKeptAmount      Float?
  /// #1199 when the order was cancelled (an edit after cancelling must not move the cancel day)
  cancelledAt           DateTime?
  createdBy             User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  customer              Customer?            @relation(fields: [customerId], references: [id])
  outlet                Outlet               @relation(fields: [outletId], references: [id])
  orderItems            OrderItem[]
  payments              Payment[]
  loyaltyTransactions   LoyaltyTransaction[]

  @@index([status, outletId])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([pickupPlanAt, returnPlanAt])
  @@index([orderNumber])
  @@index([isReadyToDeliver, outletId])
  @@index([createdAt])
  @@index([outletId, createdAt])
  @@index([orderType, status])
  @@index([outletId, status, createdAt])
  @@index([createdById, createdAt])
  @@index([totalAmount])
  @@index([status, orderType, createdAt])
  @@index([deletedAt])
}

/// #341: Idempotency-Key sent by a client with POST /api/orders, scoped to the calling user.
/// A retry or a second in-flight create with the same key returns `orderId` instead of a new order.
/// No foreign keys on purpose: the Order table is unchanged and a stale row is ignored.
model OrderCreateKey {
  id        Int      @id @default(autoincrement())
  userId    Int
  key       String
  orderId   Int
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

model OrderItem {
  id              Int                   @id @default(autoincrement())
  quantity        Int                   @default(1)
  unitPrice       Float
  totalPrice      Float
  deposit         Float                 @default(0)
  orderId         Int
  productId       Int?
  notes           String?
  rentalDays      Int?
  productName     String?
  productBarcode  String?
  productImages   Json?
  pricingType     PricingType? // snapshot of the pricing option type used
  pricingOptionId Int? // reference to the selected option (nullable)
  pricingSnapshot Json? // #1189: day-block table + days + result used for this line (null on non-BLOCK lines)
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  pricingOption   ProductPricingOption? @relation(fields: [pricingOptionId], references: [id], onDelete: SetNull)

  @@index([orderId, productId])
}

model Payment {
  id             Int           @id @default(autoincrement())
  amount         Float
  currency       String        @default("VND")
  method         PaymentMethod
  type           PaymentType
  status         PaymentStatus @default(PENDING)
  reference      String?
  transactionId  String?
  invoiceNumber  String?
  description    String?
  notes          String?
  failureReason  String?
  metadata       String?
  processedAt    DateTime?
  processedBy    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orderId        Int?
  subscriptionId Int?
  merchantId     Int?
  /// #1199 which deposit stage this payment collects ('i1', 'i2', 'rest'); null for every other payment.
  /// One COMPLETED row per (orderId, installmentKey): partial unique index in the migration (raw SQL).
  installmentKey String?
  merchant       Merchant?     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([subscriptionId, status])
  @@index([merchantId, status])
  @@index([status])
  @@index([type])
  @@index([method])
  @@index([currency])
  @@index([status, processedAt])
}

model Plan {
  id            Int                       @id @default(autoincrement())
  name          String                    @unique
  description   String
  basePrice     Float
  currency      String                    @default("VND")
  /// Stripe Price ID for subscription checkout (mode=subscription)
  stripePriceId String?                   @unique
  trialDays     Int                       @default(14)
  limits        String                    @default("{\"outlets\": 0, \"users\": 0, \"products\": 0, \"customers\": 0}")
  features      String                    @default("[]")
  isActive      Boolean                   @default(true)
  isPopular     Boolean                   @default(false)
  sortOrder     Int                       @default(0)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  deletedAt     DateTime?
  Merchant      Merchant[]
  subscriptions Subscription[]
  stripePrices  PlanStripePrice[]
  lemonVariants PlanLemonSqueezyVariant[]

  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
}

/// Billing intervals supported for Stripe Prices (Plan-level)
enum PlanBillingInterval {
  monthly
  quarterly
  semi_annual
  annual
}

/// Map Plan ↔ Stripe Price IDs by billing interval.
/// This supports: Basic/Pro each having 4 Stripe prices (monthly/quarterly/semi_annual/annual).
model PlanStripePrice {
  id              Int                 @id @default(autoincrement())
  planId          Int
  billingInterval PlanBillingInterval
  stripePriceId   String // no unique: allow same price in multiple plan/interval slots; save overwrites by (planId, billingInterval)
  currency        String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, billingInterval])
  @@index([planId])
  @@index([billingInterval])
  @@index([isActive])
}

/// Map Plan ↔ Lemon Squeezy Variant IDs by billing interval.
/// Each plan can have 4 variants (monthly/quarterly/semi_annual/annual).
model PlanLemonSqueezyVariant {
  id              Int                 @id @default(autoincrement())
  planId          Int
  billingInterval PlanBillingInterval
  /// Lemon Squeezy Variant ID (numeric string)
  lemonVariantId  String
  /// Optional override if plan variants belong to a different store
  lemonStoreId    String?
  currency        String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, billingInterval])
  @@index([planId])
  @@index([billingInterval])
  @@index([isActive])
}

model Subscription {
  id                   Int                    @id @default(autoincrement())
  merchantId           Int                    @unique
  planId               Int
  /// Stripe Subscription ID for syncing status/periods via webhooks
  stripeSubscriptionId String?                @unique
  /// Lemon Squeezy Subscription ID for syncing status/periods via webhooks
  lemonSubscriptionId  String?                @unique
  status               String                 @default("TRIAL")
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean                @default(false)
  canceledAt           DateTime?
  cancelReason         String?
  amount               Float
  currency             String                 @default("VND")
  interval             String                 @default("month")
  intervalCount        Int                    @default(1)
  period               Int                    @default(1)
  discount             Float                  @default(0)
  savings              Float                  @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  payments             Payment[]
  merchant             Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  plan                 Plan                   @relation(fields: [planId], references: [id])
  activities           SubscriptionActivity[]

  @@index([merchantId])
  @@index([planId])
  @@index([status])
  @@index([currency])
}

model SubscriptionActivity {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  type           String
  description    String
  metadata       String?
  performedBy    Int?
  createdAt      DateTime     @default(now())
  reason         String?
  user           User?        @relation(fields: [performedBy], references: [id])
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([type])
  @@index([createdAt])
}

model PlanLimitAddon {
  id                Int         @id @default(autoincrement())
  merchantId        Int
  outlets           Int         @default(0)
  users             Int         @default(0)
  products          Int         @default(0)
  customers         Int         @default(0)
  orders            Int         @default(0)
  notes             String?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  /// #850 priced add-on: the price-list row it was bought from (NULL = old free add-on)
  addonPriceId      Int?
  /// #850 snapshots at purchase: row name, limit kind, units per pack, number of packs.
  /// The kind's column above holds packSize × packs, so the limit check still sums the five columns.
  name              String?
  limitKind         String?
  packSize          Int?
  packs             Int?
  /// #870 fewer packs from the next renewal (NULL = no pending change); more packs apply at once
  nextPacks         Int?
  /// #850 VND per pack per month captured at purchase (renewal sets today's list price). NULL = old free add-on
  unitPrice         Int?
  /// #850 removal takes effect at the end of the period: the item counts until `endsAt`
  removeAtPeriodEnd Boolean     @default(false)
  endsAt            DateTime?
  endedAt           DateTime?
  /// #943 feature add-on: module key from @rentalshop/constants MODULES (e.g. "attendance"); NULL = limit add-on
  featureKey        String?
  merchant          Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  addonPrice        AddonPrice? @relation(fields: [addonPriceId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([isActive])
  @@index([merchantId, isActive])
  @@index([createdAt])
  @@index([addonPriceId])
  @@index([merchantId, featureKey])
}

/// #850 Add-on price list (admin: Plans → Add-on prices). One row = one limit kind + pack size + VND price per pack
/// per month. Several rows may share a kind (+1 user, +2 users). Never deleted; isActive false = "Tạm tắt".
model AddonPrice {
  id              Int              @id @default(autoincrement())
  name            String
  /// outlets | users | products | customers | orders | feature (#943: on/off module, packSize 1)
  limitKind       String
  /// #943 module key of a feature row (e.g. "attendance"); NULL for a limit row
  featureKey      String?
  /// Units one pack adds ("mỗi gói cộng thêm N")
  packSize        Int
  /// VND per pack per month
  monthlyPrice    Int
  currency        String           @default("VND")
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  planLimitAddons PlanLimitAddon[]

  @@index([isActive, sortOrder])
  @@index([limitKind])
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  entityType String
  entityId   String
  action     String
  details    String
  userId     Int?
  merchantId Int?
  outletId   Int?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id])
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  outlet     Outlet?   @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([merchantId, createdAt])
  @@index([outletId, createdAt])
}

model RequestLog {
  id            Int      @id @default(autoincrement())
  correlationId String   @unique // Request ID để trace
  method        String // GET, POST, PUT, DELETE
  path          String // /api/orders
  queryParams   String? // JSON string của query params
  requestBody   String? // JSON string của request body (sanitized)
  responseBody  String? // JSON string của response body (sanitized)
  statusCode    Int // 200, 404, 500
  duration      Int // milliseconds
  userId        Int? // User ID nếu authenticated
  merchantId    Int? // Merchant ID nếu có
  outletId      Int? // Outlet ID nếu có
  ipAddress     String?
  userAgent     String?
  errorMessage  String? // Nếu có error
  createdAt     DateTime @default(now())

  user     User?     @relation("RequestLogs", fields: [userId], references: [id])
  merchant Merchant? @relation("RequestLogs", fields: [merchantId], references: [id])

  @@index([correlationId])
  @@index([method, path])
  @@index([userId])
  @@index([merchantId])
  @@index([createdAt])
  @@index([statusCode])
  @@index([path])
}

model EmailVerification {
  id         Int       @id @default(autoincrement())
  userId     Int
  token      String    @unique
  email      String
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([email])
  @@index([expiresAt])
  @@index([verified])
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  email     String
  used      Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([email])
  @@index([expiresAt])
  @@index([used])
}

model MerchantRole {
  id           Int       @id @default(autoincrement())
  merchantId   Int
  roleName     String
  isSystemRole Boolean   @default(false)
  systemRole   UserRole?
  description  String?
  permissions  String[]
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  merchant     Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([merchantId, roleName])
  @@index([merchantId])
  @@index([roleName])
  @@index([merchantId, roleName])
  @@index([merchantId, isSystemRole])
  @@index([systemRole])
}

model BankAccount {
  id                Int      @id @default(autoincrement())
  accountHolderName String
  accountNumber     String
  bankName          String
  bankCode          String?
  branch            String?
  isDefault         Boolean  @default(false)
  qrCode            String?
  notes             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  outletId          Int
  outlet            Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@index([outletId, isDefault])
  @@index([outletId, isActive])
}

